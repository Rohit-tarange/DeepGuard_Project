# ============================================================
#  Tathya Fact-Checking System – Subpackage Env Template
#  Copy this file to '.env' inside fact_check_system/ or root
# ============================================================

# ── Groq (Primary LLM) ──────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_PARSER_MODEL=openai/gpt-oss-20b

# ── Gemini (Google AI Search Tool) ──────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ── Tavily Search ────────────────────────────────────────────
TAVILY_API_KEY2=your_tavily_api_key_here

# ── NewsAPI ──────────────────────────────────────────────────
NEWS_API_KEY=your_news_api_key_here

# ── Azure OpenAI (Optional) ──────────────────────────────────
AZURE_OPENAI_API_KEY_O3_mini=your_azure_openai_o3_mini_key_here
AZURE_OPENAI_ENDPOINT_O3_mini=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION_O3_mini=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME_O3_mini=o3-mini

AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT_NAME=gpt-4o-mini

# ── Confidence Thresholds ────────────────────────────────────
HIGH_CONFIDENCE_THRESHOLD=0.8
MEDIUM_CONFIDENCE_THRESHOLD=0.5
LOW_CONFIDENCE_THRESHOLD=0.3
